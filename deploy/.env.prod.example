PROJECT_NAME=

APP_NAME=
APP_ENV=
APP_KEY=
APP_URL=
APP_LOCALE=it
APP_FALLBACK_LOCALE=it

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

# Email di notifica (assegnazioni, commenti, cambi stato).
# Senza queste variabili MAIL_MAILER resta "log" e le email non partono.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Token statico dell'API /api/projects consumata dal gestionale esterno.
# Deve coincidere con PM_API_TOKEN nel .env del gestionale.
GESTIONALE_API_TOKEN=

# Login con Google (opzionale). Il redirect e' <APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
